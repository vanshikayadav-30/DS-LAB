#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *next, *prev;
};

struct node *insert_starting(struct node *head, int data)
{
    struct node *p = malloc(sizeof(struct node));

    if (p == NULL)
    {
        printf("Allocation Error\n");
        return head;
    }

    p->data = data;
    p->prev = NULL;
    p->next = head;

    if (head != NULL)
        head->prev = p;

    return p;
}

struct node *insert_ending(struct node *head, int data)
{
    struct node *p = malloc(sizeof(struct node));
    struct node *t = head;

    if (p == NULL)
    {
        printf("Allocation Error\n");
        return head;
    }

    p->data = data;
    p->next = NULL;
    p->prev = NULL;

    if (head == NULL)
        return p;

    while (t->next != NULL)
        t = t->next;

    t->next = p;
    p->prev = t;

    return head;
}

struct node *insert_position(struct node *head, int data, int position)
{
    int count = 1;
    struct node *p, *t = head;

    if (position < 1)
    {
        printf("Invalid position\n");
        return head;
    }

    if (position == 1)
        return insert_starting(head, data);

    while (t != NULL && count < position - 1)
    {
        t = t->next;
        count++;
    }

    if (t == NULL)
    {
        printf("Invalid position\n");
        return head;
    }

    p = malloc(sizeof(struct node));

    if (p == NULL)
    {
        printf("Allocation Error\n");
        return head;
    }

    p->data = data;
    p->prev = t;
    p->next = t->next;

    if (t->next != NULL)
        t->next->prev = p;

    t->next = p;

    return head;
}

void display(struct node *head)
{
    struct node *t = head;

    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    while (t != NULL)
    {
        printf("%d ", t->data);
        t = t->next;
    }

    printf("\n");
}

int main(void)
{
    struct node *head = NULL;

    head = insert_starting(head, 20);
    head = insert_starting(head, 10);
    head = insert_ending(head, 30);
    head = insert_position(head, 15, 2);

    printf("Doubly Linked List: ");
    display(head);

    return 0;
}
